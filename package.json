{
  "name": "soynativo-app",
  "version": "0.1.0",
  "private": true,
  "description": "Language Learning Platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"yarn workspace @soynativo/backend dev\" \"yarn workspace @soynativo/mobile start\"",
    "build": "yarn workspaces foreach --all run build",
    "test": "yarn workspaces foreach --all run test",
    "test:watch": "yarn workspaces foreach --all run test:watch",
    "lint": "yarn workspaces foreach --all run lint",
    "format": "yarn workspaces foreach --all run format",
    "type-check": "yarn workspaces foreach --all run type-check",
    "prepare": "husky install"
  },
  "workspaces": [
    "apps/mobile",
    "apps/backend",
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.1.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=3.6.0"
  }
}
