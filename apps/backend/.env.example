# --- Server ---
NODE_ENV=development
PORT=3000
API_PREFIX=/api
API_VERSION=v1

# --- Database ---
DATABASE_URL=postgres://soynativo:soynativo@localhost:5432/soynativo
DATABASE_POOL_SIZE=10
DATABASE_LOGGING=false

# --- Redis (cache + BullMQ queues) ---
REDIS_URL=redis://localhost:6379

# --- Auth (generate with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=replace-me-with-a-32+char-random-string-please-do-it
JWT_REFRESH_SECRET=replace-me-with-a-different-32+char-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:19006,http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Google Meet ---
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
# GOOGLE_MEET_REDIRECT_URI=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=

# --- Observability ---
LOG_LEVEL=debug
# SENTRY_DSN=
