{
  "name": "@soynativo/backend",
  "version": "0.1.0",
  "description": "Soynativo Backend API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --import @swc-node/register/esm-register --watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit",
    "test": "jest --selectProjects unit",
    "test:watch": "jest --selectProjects unit --watch",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:all": "jest",
    "test:coverage": "jest --coverage",
    "migration:create": "tsx ./node_modules/typeorm/cli.js migration:create",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d src/core/database/data-source.ts",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d src/core/database/data-source.ts",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/core/database/data-source.ts",
    "seed": "tsx src/core/database/seeds/run-seeds.ts",
    "worker:notifications": "tsx src/core/queue/workers/notifications.worker.ts",
    "bench": "tsx scripts/bench/run-bench.ts"
  },
  "dependencies": {
    "@soynativo/shared": "*",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "pino": "^8.17.2",
    "pino-http": "^9.0.0",
    "pino-pretty": "^10.3.1",
    "reflect-metadata": "^0.2.1",
    "socket.io": "^4.7.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "telegraf": "^4.14.0",
    "tsyringe": "^4.8.0",
    "typeorm": "^0.3.17",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.32",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.10.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "autocannon": "^7.14.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2"
  }
}
