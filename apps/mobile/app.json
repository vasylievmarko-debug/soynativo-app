{
  "expo": {
    "name": "Soynativo",
    "slug": "soynativo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.soynativo.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Soynativo uses the camera during video lessons.",
        "NSMicrophoneUsageDescription": "Soynativo uses the microphone during video lessons."
      }
    },
    "android": {
      "package": "com.soynativo.app",
      "versionCode": 1,
      "permissions": ["CAMERA", "RECORD_AUDIO"]
    },
    "plugins": [
      ["expo-camera", { "cameraPermission": "Allow Soynativo to access your camera for video lessons" }],
      "expo-secure-store",
      "expo-localization"
    ],
    "extra": {
      "eas": { "projectId": "REPLACE_WITH_EAS_PROJECT_ID" }
    }
  }
}
